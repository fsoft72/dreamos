# live-build working directories
.build/
config/.build/
chroot/
chroot.packages.live
chroot.packages.install
binary/
binary.modified/
cache/

# build artifacts
*.iso
*.img
*.log
*.buildlog
binary.modified_timestamps
chroot.files
chroot.packages.live
chroot.packages.install
live-image-*.contents
live-image-*.files
live-image-*.packages

# The whole config/ tree is regenerated by `lb config` from auto/config.
# Track only the hand-authored files below; ignore everything else.
/config/*
!/config/hooks/
!/config/includes.chroot/
!/config/package-lists/
!/config/bootloaders/

# hooks/: live-build symlinks its own hooks here on every `lb config`.
# Keep only our 0xxx-prefixed custom hooks.
/config/hooks/*
!/config/hooks/normal/
/config/hooks/normal/*
!/config/hooks/normal/0*.hook.chroot

# package-lists/: live.list.chroot is generated. Keep only our lists.
/config/package-lists/*
!/config/package-lists/desktop.list.chroot
!/config/package-lists/network.list.chroot
!/config/package-lists/system.list.chroot
!/config/package-lists/installer.list.chroot

# OpusDM binaries: staged by scripts/build-opusdm.sh into the ISO tree.
# They are build artifacts (trixie container output), never committed.
# The whole directory is ignored so any workspace [[bin]] target the script
# picks up automatically stays untracked too, with no edits needed here.
/config/includes.chroot/usr/bin/*

# The compiled OpusDM binaries do travel in git as this one tracked
# tarball (scripts/build-opusdm.sh writes it, build.sh unpacks it), so
# the GitHub Actions ISO build does not need the private OpusDM repo.
!/vendor/opusdm/opusdm-bin.tar.gz

# Same for the compiled dreamos-tools binaries (scripts/build-opusdm.sh
# writes this tarball too; nothing currently unpacks it, see the script).
!/vendor/dreamos-tools/dreamos-tools-bin.tar.gz

# start.sh UEFI NVRAM
.ovmf-vars.fd

# editor noise
*~
.DS_Store
