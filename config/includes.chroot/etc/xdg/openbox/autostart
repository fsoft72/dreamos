# dreamos Openbox session autostart - OpusDM desktop shell.
#
# opusdm-hub is the desktop: a full-screen keep-below window that draws
# the background and desktop icons, plus its own toolbar. It also finds
# opusdm-lister next to itself (/usr/bin) and opens the first Lister
# window on $HOME. No separate panel or wallpaper setter is needed.
#
# picom is the X compositor (tear-free redraws, shadows, fades). It uses
# the xrender backend: it needs no OpenGL, so it works the same on real
# hardware, on virgl and on VMs without 3D acceleration. It starts before
# opusdm-hub so the desktop windows are composited from the first frame.
#
# picom runs on the user's ~/.config/opusdm/picom.conf (seeded from
# /etc/skel by build-opusdm.sh): xrender backend, shadows, window opacity,
# fading. Without --config picom used its built-in defaults, so there were
# no shadows and no transparency. The hub rewrites the opacity keys of that
# file (Settings, Windows tab) from OPUSDM_PICOM_BASE and signals picom to
# reload it (pkill -USR1 picom).
OPUSDM_PICOM_BASE=/etc/skel/.config/opusdm/picom.conf
export OPUSDM_PICOM_BASE
picom --config "${HOME}/.config/opusdm/picom.conf" &
opusdm-hub &
